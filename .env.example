# See docs/environments.md for owners and setup. Do not commit real secrets.
# Prefer npm run env:local to generate .env.local from supabase status.
APP_PROFILE=local
MACHINE_ONLY_ENABLED=true
VITE_APP_PROFILE=local
ALLOW_HOSTED_SUPABASE=false
VITE_ALLOW_HOSTED_SUPABASE=false
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Separate server-only operational Supabase. Never add VITE_ variants.
OPERATIONAL_DB_ENABLED=true
OPERATIONAL_SUPABASE_URL=http://127.0.0.1:55321
OPERATIONAL_SUPABASE_SERVICE_ROLE_KEY=
OPERATIONAL_CANDLE_RETENTION_DAYS=8
OPERATIONAL_MONITOR_RUN_RETENTION_DAYS=30
OPERATIONAL_OUTBOX_MAX_ATTEMPTS=10
# Server-only. dev:local:all overrides this to true for the app and collector worker.
BINANCE_COLLECTOR_ENABLED=false
# Machine-side watchlist reconciliation; default on when collector/DB credentials are configured.
COLLECTOR_UNIVERSE_SYNC_ENABLED=true
# Milliseconds: default 60000, minimum 10000. No VITE_ variants.
COLLECTOR_UNIVERSE_SYNC_INTERVAL_MS=60000
# Server-only V1 lateness watermark (ms) for the shared five-second movement buckets.
MOVEMENT_FINALIZATION_GRACE_MS=2000
# Optional metadata; not used to select the target.
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
PYTHON_ANALYSIS_ENABLED=false
PYTHON_ANALYSIS_URL=http://127.0.0.1:8000
PYTHON_ANALYSIS_TOKEN=
MONITOR_CRON_TOKEN=
CRON_SECRET=
CRON_SECRET_PREVIOUS=
SCHEDULED_MONITOR_ENABLED=false
VITE_MARKET_AUTO_REFRESH_ENABLED=false
VITE_TA_HISTORY_AUTO_REFRESH_ENABLED=false
TA_GENERATION_ENABLED=true
TA_OUTCOME_EVALUATION_ENABLED=true
ACTIVITY_DIAGNOSTICS=false
VITE_ACTIVITY_DIAGNOSTICS=false
# Optional public Google OAuth client ID for Google sign-in; leave empty to hide it.
VITE_GOOGLE_CLIENT_ID=

# Owner-machine HTTP gateway (worker:host only; never VITE_).
RUNNER_GATEWAY_ENABLED=true
RUNNER_GATEWAY_PORT=8787
# Replace with 32–256 random URL-safe characters before starting worker:host.
RUNNER_GATEWAY_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS

# Durable on-demand jobs (Worker and worker:host; independent of the gateway).
RUNNER_JOBS_ENABLED=true
# Hourly forex market stage (#397), a worker-host child. Keep false until the MT5 forex collector writes bars.
FX_HOURLY_ENABLED=false
